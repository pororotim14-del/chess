# ============================================================
# Release signing template for Chess Engine Assistant.
#
# To sign release builds:
#   1. cp keystore.properties.example keystore.properties
#   2. Generate a keystore:
#        keytool -genkeypair -v -keystore release.keystore \
#                -alias chess -keyalg RSA -keysize 2048 -validity 10000
#   3. Fill in the real values below.
#
# NEVER commit keystore.properties. It is git-ignored.
# You may instead export these values as environment variables;
# app/build.gradle.kts prefers the file, then environment variables.
# ============================================================

KEYSTORE_FILE=release.keystore
KEYSTORE_PASSWORD=change-me
KEY_ALIAS=chess
KEY_PASSWORD=change-me